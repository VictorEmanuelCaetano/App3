<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppHotel2.Views.HospedagemContratada"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#E8F5E9"
             Title="HospedagemContratada">

    <VerticalStackLayout Padding="20" Spacing="10" VerticalOptions="Center">

        <Label Text="Suíte Super Luxo"
               FontFamily="PoppinsBold"
               FontSize="32"
               TextColor="#2E7D32"
               HorizontalOptions="Center" />

        <Label Text="Adultos: 2" />
        <Label Text="Crianças: 1" />
        <Label Text="Check-in: 27/05/2024" />
        <Label Text="Check-out: 30/05/2024" />
        <Label Text="Estadia: 3 dias" />
        <Label Text="Valor Total: R$ 750,00" FontFamily="PoppinsBold" />

        <Button Text="Voltar" BackgroundColor="#2E7D32" Clicked="Button_Voltar_Clicked" />

    </VerticalStackLayout>
</ContentPage>
